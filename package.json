{
  "name": "tree-sitter-lang",
  "version": "0.2.0",
  "description": "Tree-sitter grammar for Minecraft Bedrock Edition .lang localization files.",
  "repository": "https://github.com/rockide/tree-sitter-lang",
  "license": "MIT",
  "author": {
    "name": "rockide",
    "email": "renixiel@gmail.com",
    "url": "https://svdex.moe/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "minecraft",
    "bedrock",
    "localization",
    "lang"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:fixtures": "tree-sitter parse fixtures/*.lang --quiet",
    "test:highlights": "tree-sitter highlight --check test/highlight/*.lang",
    "test:wasm": "tree-sitter build --wasm",
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground"
  }
}
